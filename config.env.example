# Salin file ini menjadi "config.env" (tanpa .example), ubah seperlunya, lalu jalankan ulang server.
# Baris berawalan # diabaikan. Jangan pakai tanda kutip kecuali nilai mengandung spasi.

# Port server (alamat: http://IP-SERVER:PORT/admin/)
PORT=3000

# Lokasi database & foto. Kosong = folder "data" di samping server.js
#DATA_DIR=D:\toko-data

# BACKUP OTOMATIS ke komputer/gedung lain (sangat disarankan untuk dua gedung).
# Isi dengan folder bersama di komputer gudang, mis. \\GUDANG-PC\backup-toko   atau  folder flashdisk, mis. E:\backup-toko
#BACKUP_DIR=\\GUDANG-PC\backup-toko
# Backup dibuat saat server menyala lalu tiap N jam; simpan N file terbaru
BACKUP_EVERY_HOURS=6
BACKUP_KEEP=30

# Data contoh saat pertama kali jalan (0 = mulai kosong)
#SEED_DEMO=0

# Hanya jika server diakses lewat proxy/tunnel (tidak dipakai pada jaringan lokal biasa)
#TRUST_PROXY=1

# ---- Tailscale (lihat README bagian 7) ----
# Hanya layani komputer ini sendiri; dipakai bila akses lewat "tailscale serve" (HTTPS dari Tailscale)
#HOST=127.0.0.1
# Dengan "tailscale serve", IP asli HP dibaca dari header proxy (untuk pembatas login/pesanan)
#TRUST_PROXY=1
# Nama komputer di Tailscale (MagicDNS), mis. toko-server.nama-tailnet.ts.net: ditampilkan di Pengaturan
#PUBLIC_HOST=toko-server.nama-tailnet.ts.net
# Sertifikat HTTPS dari "tailscale cert" (alternatif tailscale serve); kosong = certs/cert.pem & certs/key.pem
#TLS_CERT=C:\toko\toko-server.nama-tailnet.ts.net.crt
#TLS_KEY=C:\toko\toko-server.nama-tailnet.ts.net.key

# Bila server memakai HTTPS buatan sendiri (npm run cert), tombol "Install" di Chrome PC ini tidak muncul.
# Port tambahan ini membuka http://localhost:PORT/admin/ khusus di komputer server (tidak terlihat dari jaringan).
#LOCAL_HTTP_PORT=3001
